# Copy to .env and fill in. NEVER commit .env - it contains your Steam password.
#
# The DayZ server cannot be downloaded anonymously. Use a Steam account that
# owns DayZ. A dedicated secondary account is recommended.

STEAM_USERNAME=
STEAM_PASSWORD=
# Fill only when Steam asks for a code, then clear it again afterwards.
STEAM_GUARD_CODE=

DAYZ_PORT=2302
DAYZ_AUTO_UPDATE=1     # 1 = run steamcmd update on every container start
DAYZ_VALIDATE=0        # 1 = validate all server files on update (slow)

# Extra arguments appended to the DayZServer command line, e.g.:
# DAYZ_EXTRA_ARGS=-limitFPS=60
DAYZ_EXTRA_ARGS=
